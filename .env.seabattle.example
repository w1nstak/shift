# Shift Sea Battle API
# Public HTTPS URL that Telegram Mini App can reach (ngrok / Cloudflare Tunnel / VPS)
# Example: GAME_API_URL=https://xxxx.ngrok-free.app
GAME_API_URL=
GAME_API_HOST=0.0.0.0
GAME_API_PORT=8787
# Allow X-Shift-User headers without Telegram initData (local testing only)
GAME_API_DEV=0
# Auto-match Shift AI after N seconds in Quick Battle queue
SEA_BATTLE_MATCH_BOT_AFTER=12
